# Soratra needs no settings to run. Copy this file to .env next to compose.yaml
# only to change one of the defaults below.

# Reach Soratra from your phone or other devices on your network.
# SORATRA_BIND=0.0.0.0
# SORATRA_PORT=3000

# Pin a release instead of following the latest 1.x.
# SORATRA_VERSION=1

# For compose.caddy.yaml: your domain, without https://.
# DOMAIN=books.example.org

# How many daily backups to keep in ./backups.
# KEEP_BACKUPS=7

# Let search engines index the landing page (off by default).
# SEARCH_INDEXING=true
# Your public address, used for link previews and the sitemap.
# SITE_URL=https://books.example.org

# Behind your own reverse proxy: a header it overwrites with the visitor's IP.
# TRUSTED_PROXY_IP_HEADER=x-real-ip

# Publish /.well-known/security.txt (both are needed).
# SECURITY_CONTACT=mailto:you@example.org
# SECURITY_EXPIRES=2027-12-31T00:00:00Z

# Only if you modified Soratra and host your source elsewhere (AGPL).
# SOURCE_CODE_URL=https://example.org/your-soratra-source

# Development with `npm run dev` and compose.dev.yaml.
# POSTGRES_URL=postgres://soratra:soratra@localhost:5432/soratra
